{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/client/**", "src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Route files export a Route object next to their component (the router plugin splits them
      // for Fast Refresh), and shadcn components export their variants on purpose.
      "files": ["src/routes/**", "src/components/ui/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
